<Window x:Class="RemoteGamepad.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程手柄" Width="1120" Height="820" MinWidth="860" MinHeight="650"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Text}" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Window_PreviewKeyDown" GotKeyboardFocus="Window_GotKeyboardFocus"
        Closing="Window_Closing">
    <ScrollViewer x:Name="ZoomViewport" Focusable="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="ZoomViewport_SizeChanged">
    <Grid x:Name="RootGrid" Margin="26,20" MinWidth="800">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Ctrl+加号 / 减号缩放，Ctrl+0 恢复"/>
                <Border Background="{DynamicResource StatusFill}" CornerRadius="13" Padding="12,5" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="HeaderStatus" Text="●  未连接" Foreground="{DynamicResource Accent}" FontSize="12"/>
                </Border>
                <Button x:Name="ThemeButton" Content="亮色主题" Click="Theme_Click" ToolTip="Alt+T 切换主题"/>
            </StackPanel>
            <StackPanel><TextBlock Text="REMOTE GAMEPAD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                <TextBlock Text="远程手柄控制台" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock x:Name="KeyboardHelp" Text="方向键定位 · 回车操作 / 编辑 · Esc 取消编辑 · F1 帮助" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14"><TextBlock Text="连接服务端" FontSize="16" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="DIRECT  /  AGGREGATE" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="80"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Style="{StaticResource FieldLabel}" Text="服务端 IP / 主机名"/><TextBox x:Name="HostBox" MinWidth="150" IsReadOnly="True" LostFocus="Host_LostFocus" LostKeyboardFocus="TextBox_LostKeyboardFocus" PreviewMouseLeftButtonDown="TextBox_MouseDown"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource FieldLabel}" Text="端口"/><TextBox x:Name="PortBox" Text="26760" IsReadOnly="True" LostKeyboardFocus="TextBox_LostKeyboardFocus" PreviewMouseLeftButtonDown="TextBox_MouseDown"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Style="{StaticResource FieldLabel}" Text="手柄编号"/><TextBox x:Name="SlotBox" Text="0" IsReadOnly="True" LostKeyboardFocus="TextBox_LostKeyboardFocus" PreviewMouseLeftButtonDown="TextBox_MouseDown"/></StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Style="{StaticResource FieldLabel}" Text="唤醒 MAC（可选）"/><TextBox x:Name="MacBox" MinWidth="155" IsReadOnly="True" LostKeyboardFocus="TextBox_LostKeyboardFocus" PreviewMouseLeftButtonDown="TextBox_MouseDown"/></StackPanel>
                            <CheckBox Grid.Column="4" x:Name="AggregateCheck" Content="聚合端口" Margin="0,18,14,0" Checked="Aggregate_Changed" Unchecked="Aggregate_Changed"/>
                            <Button Grid.Column="5" x:Name="ConnectButton" Content="连接" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" FontWeight="Bold" Margin="0,18,0,0" MinWidth="78" Click="Connect_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Style="{StaticResource MetricTitle}" Text="CPU 占用"/><TextBlock x:Name="CpuValue" Style="{StaticResource MetricValue}" Text="--"/><ProgressBar x:Name="CpuBar"/><TextBlock x:Name="CpuPower" Text="功耗 -- W" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" FontSize="12"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Style="{StaticResource MetricTitle}" Text="物理内存"/><TextBlock x:Name="MemoryValue" Style="{StaticResource MetricValue}" Text="--"/><ProgressBar x:Name="MemoryBar"/><TextBlock x:Name="MemoryDetail" Text="-- / --" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" FontSize="12"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Style="{StaticResource MetricTitle}" Text="GPU 占用"/><TextBlock x:Name="GpuValue" Style="{StaticResource MetricValue}" Text="--"/><ProgressBar x:Name="GpuBar"/><TextBlock x:Name="GpuPower" Text="功耗 -- W" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" FontSize="12"/></StackPanel></Border>
                    <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource MetricTitle}" Text="显存占用"/><TextBlock x:Name="VramValue" Style="{StaticResource MetricValue}" Text="--"/><ProgressBar x:Name="VramBar"/><TextBlock x:Name="VramDetail" Text="-- / --" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" FontSize="12"/></StackPanel></Border>
                </Grid>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="服务端前台应用" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="ForegroundValue" Text="等待性能数据" FontSize="14" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="FpsValue" Text="--" FontSize="26" FontWeight="SemiBold"/><TextBlock Text=" FPS" Foreground="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="0,0,0,5"/></StackPanel>
                    </Grid>
                </Border>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="键鼠控制" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="InputStatus" Text="未连接" Foreground="{DynamicResource Muted}" Margin="0,6,0,13"/>
                        <CheckBox x:Name="InputToggle" Content="转发键盘和鼠标" Checked="Input_Changed" Unchecked="Input_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0"><RadioButton x:Name="AbsoluteMode" GroupName="MouseMode" Content="绝对模式" Margin="0,0,25,0" Checked="MouseMode_Changed"/><RadioButton x:Name="RelativeMode" GroupName="MouseMode" Content="增量模式" Checked="MouseMode_Changed"/></StackPanel>
                        <TextBlock Text="Ctrl + Esc 切换转发 · 修改模式前请关闭转发" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
                    </StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="电源与唤醒" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="MacStatus" Text="MAC 未设置" Foreground="{DynamicResource Muted}" Margin="0,6,0,13"/>
                        <CheckBox x:Name="AutoSleep" Content="断开 60 秒后睡眠" Checked="AutoSleep_Changed" Unchecked="AutoSleep_Changed"/>
                        <WrapPanel Margin="0,14,0,0"><Button x:Name="WakeButton" Content="网络唤醒" Click="Wake_Click" Margin="0,0,8,0"/><Button x:Name="SleepButton" Content="服务端睡眠" Click="Sleep_Click" Margin="0,0,8,0"/><Button x:Name="SaveMacButton" Content="保存 MAC" Click="SaveMac_Click"/></WrapPanel>
                    </StackPanel></Border>
                </Grid>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <DockPanel Margin="0,0,0,10"><TextBlock Text="连接状态" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionStatus" Text="手柄 --   ·   声音 --   ·   键鼠 --" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
                    <ListBox x:Name="LogList" Height="132" Background="{DynamicResource Field}" Foreground="{DynamicResource Muted}" BorderThickness="0" Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None" KeyboardNavigation.DirectionalNavigation="None" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </ScrollViewer>
</Window>
