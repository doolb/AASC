<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="96dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/modelStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/loading_model" android:textSize="16sp" />
        <Spinner android:id="@+id/cpuModeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
        <TextView android:id="@+id/audioInputLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/audio_input_label" android:textSize="14sp" />
        <Spinner android:id="@+id/audioInputSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/refreshAudioInputButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/audio_input_refresh" />
        <TextView android:id="@+id/audioInputStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/audio_input_loading" android:textSize="14sp" />
        <Button android:id="@+id/selectAudioButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/select_audio" />
        <Button android:id="@+id/playAudioButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:enabled="false" android:text="@string/play_audio" />
        <Button android:id="@+id/saveAudioButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:enabled="false" android:text="@string/save_audio" />
        <TextView android:id="@+id/audioStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/no_audio" android:textSize="14sp" />
        <com.aasc.asr.VolumeChartView android:id="@+id/audioVolumeChart" android:layout_width="match_parent"
            android:layout_height="180dp" android:layout_marginTop="12dp" android:visibility="gone"
            android:background="#F7F7F7" />
        <Button android:id="@+id/recognizeButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/recognize" />
        <Switch android:id="@+id/asrDenoise" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/asr_denoise" />
        <TextView android:id="@+id/resultText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:minHeight="120dp" android:text="@string/recognition_result"
            android:textIsSelectable="true" android:textSize="18sp" />
        <TextView android:id="@+id/voiceprintTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/voiceprint_title" android:textSize="18sp"
            android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/voiceprint_model_label" android:textSize="14sp" />
        <Spinner android:id="@+id/voiceprintModelSpinner" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:enabled="false" />
        <TextView android:id="@+id/voiceprintPrecisionLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/voiceprint_precision_label" android:textSize="14sp" />
        <Spinner android:id="@+id/voiceprintPrecisionSpinner" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:enabled="false" />
        <TextView android:id="@+id/voiceprintStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/voiceprint_loading" android:textSize="14sp" />
        <EditText android:id="@+id/speakerName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/voiceprint_speaker_hint" android:inputType="text" />
        <Switch android:id="@+id/voiceprintDenoise" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/voiceprint_denoise" />
        <Button android:id="@+id/registerSpeaker" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:enabled="false" android:text="@string/voiceprint_register" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/voiceprint_speaker_count" android:textSize="14sp" />
        <Spinner android:id="@+id/speakerCount" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:enabled="false" />
        <Button android:id="@+id/testSingle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:enabled="false" android:text="@string/voiceprint_test_single" />
        <Button android:id="@+id/testMulti" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:enabled="false" android:text="@string/voiceprint_test_multi" />
        <Button android:id="@+id/testMultiFast" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:enabled="false" android:text="@string/voiceprint_test_multi_fast" />
        <TextView android:id="@+id/voiceprintResult" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:minHeight="220dp" android:text="@string/voiceprint_result"
            android:textIsSelectable="true" android:textSize="14sp" />
        <TextView android:id="@+id/httpStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/http_loading" android:textSize="15sp" />
        <EditText android:id="@+id/httpPortInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/http_port_hint" android:inputType="number" android:text="18080" />
        <Button android:id="@+id/httpToggleButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:enabled="false" android:text="@string/http_start" />
        </LinearLayout>
    </ScrollView>

    <!-- 录音按钮浮在滚动内容之上，固定于屏幕底部中央，避免长页面滚动后无法停止录音。 -->
    <LinearLayout android:id="@+id/recordControlOverlay" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal"
        android:background="#F2FFFFFF" android:elevation="8dp" android:gravity="center"
        android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="8dp"
        android:paddingEnd="12dp" android:paddingBottom="8dp">
        <Button android:id="@+id/recordButton" android:layout_width="220dp" android:layout_height="wrap_content"
            android:text="@string/record_start" />
    </LinearLayout>
</FrameLayout>
