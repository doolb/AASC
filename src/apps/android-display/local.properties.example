# Android SDK 路径按本机环境填写
sdk.dir=/opt/android-sdk

# Release keystore 默认使用复制自原 debug.keystore 的 ~/.android/aasc-release.keystore。
# 当前测试兼容配置使用 Android Debug keystore 的默认别名和密码。
# 正式发布时应替换为独立生产 keystore，并且不要把真实密码提交到 Git。
# 也可以改用 AASC_RELEASE_* 环境变量。
aasc.release.storeFile=/home/your-user/.android/aasc-release.keystore
aasc.release.storePassword=android
aasc.release.keyAlias=androiddebugkey
aasc.release.keyPassword=android
