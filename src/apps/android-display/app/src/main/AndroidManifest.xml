<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11+ 允许识别桌面应用，用于仅在桌面显示壁纸浮窗。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 关闭任务时将本应用的桌面动态壁纸恢复为系统默认壁纸。 -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android WebView 创建 getUserMedia 录音设备所需的普通安装权限。 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 经典蓝牙 SCO 路由；Android 12+ 的 BLUETOOTH_CONNECT 还需运行时授权。 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- Samsung DeX 下 0dp 启动尺寸表示启动即全屏，避免进入 freeform 小窗口。 -->
        <meta-data
            android:name="com.samsung.android.dex.launchwidth"
            android:value="0" />
        <meta-data
            android:name="com.samsung.android.dex.launchheight"
            android:value="0" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|density"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".OfflineLauncherActivity" android:exported="false" />
        <activity android:name=".SafDirectoryPickerActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|density" />

        <!-- 登录 WebView 使用独立进程和独立 Cookie/LocalStorage 数据目录，禁止外部应用启动。 -->
        <activity
            android:name=".Chat2ApiLoginActivity"
            android:exported="false"
            android:process=":chat2api_login"
            android:screenOrientation="portrait" />

        <!-- 查看后台同一个WebView；关闭仅卸载视图，页面和请求继续由Service持有。 -->
        <activity
            android:name=".DoubaoWebViewActivity"
            android:exported="false"
            android:process=":chat2api_login"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- 与外部登录页共用隔离 WebView 数据目录；只接受同应用绑定。 -->
        <service
            android:name=".DoubaoWebViewService"
            android:exported="false"
            android:process=":chat2api_login" />

        <service
            android:name=".DisplayAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".DisplayWallpaperService"
            android:label="@string/wallpaper_title"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/display_wallpaper" />
        </service>

        <service
            android:name=".NodeServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".OfflineApkInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
