<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/configBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#222222">

        <EditText
            android:id="@+id/serverInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/server_hint"
            android:inputType="textUri"
            android:imeOptions="actionGo" />

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 控制按钮由 XML 作为容器顶层子项保留，控制端 WebView 运行时插入到它的下方。 -->
        <Button
            android:id="@+id/controlToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:elevation="12dp"
            android:text="@string/control_page"
            android:visibility="gone" />

        <!-- 首次解包或 Node 服务启动期间覆盖 WebView，避免用户看到短暂的连接拒绝错误。 -->
        <LinearLayout
            android:id="@+id/offlineStartupPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#E6000000"
            android:clickable="true"
            android:elevation="20dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/offlineStartupProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/offlineStartupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/offline_startup_title"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/offlineStartupMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:maxWidth="720dp"
                android:text="@string/offline_startup_preparing"
                android:textColor="#E6E6E6"
                android:textSize="17sp" />

            <Button
                android:id="@+id/offlineStartupRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/offline_startup_retry"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 服务代码、生产依赖和 min APK 共用右下角更新卡片；下载前都需要用户明确确认。 -->
        <LinearLayout
            android:id="@+id/offlineUpdatePanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="#F21B1B1B"
            android:clickable="true"
            android:elevation="30dp"
            android:focusable="true"
            android:minWidth="300dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/offlineUpdateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offline_update_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/offlineUpdateMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="420dp"
                android:text="@string/offline_update_available_default"
                android:textColor="#E6E6E6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/offlineUpdateNotesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/offline_update_notes_title"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/offlineUpdateNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="6"
                android:maxWidth="420dp"
                android:textColor="#E6E6E6"
                android:textSize="13sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/offlineUpdateProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/offlineUpdateLater"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/offline_update_later" />

                <Button
                    android:id="@+id/offlineUpdateDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/offline_update_download" />
            </LinearLayout>
        </LinearLayout>

        <!-- Offline 现场诊断信息位于右下角，不接收输入，层级低于启动遮罩和更新卡片。 -->
        <TextView
            android:id="@+id/offlineDisplayInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="#99000000"
            android:clickable="false"
            android:elevation="8dp"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
